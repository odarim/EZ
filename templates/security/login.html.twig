{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 40px;
            width: 100%;
            max-width: 400px;
            border: none;
        }

        .app-brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .app-brand-logo {
            width: 40px;
            height: 40px;
            background: #7c3aed;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .app-brand-text {
            font-size: 24px;
            font-weight: 700;
            color: #6b7280;
            display: block;
        }

        .welcome-title {
            font-size: 24px;
            font-weight: 600;
            color: #1f2937;
            text-align: center;
            margin-bottom: 8px;
        }

        .welcome-subtitle {
            color: #6b7280;
            text-align: center;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .form-label {
            color: #374151;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-control {
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 14px;
            transition: all 0.2s;
        }

        .form-control:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
        }

        .password-toggle {
            position: relative;
        }

        .password-toggle .toggle-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            cursor: pointer;
            z-index: 10;
        }

        .forgot-password {
            color: #7c3aed;
            text-decoration: none;
            font-size: 12px;
        }

        .forgot-password:hover {
            color: #5b21b6;
        }

        .btn-primary {
            background: #7c3aed;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            background: #5b21b6;
            transform: translateY(-1px);
        }

        .btn-primary:disabled {
            background: #9ca3af;
            transform: none;
        }

        .form-check-input:checked {
            background-color: #7c3aed;
            border-color: #7c3aed;
        }

        .divider {
            position: relative;
            text-align: center;
            margin: 30px 0;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e5e7eb;
        }

        .divider-text {
            background: white;
            color: #6b7280;
            padding: 0 15px;
            font-size: 14px;
        }

        .social-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .btn-social {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e7eb;
            background: white;
            color: #6b7280;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-social:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .btn-social.facebook:hover {
            color: #1877f2;
            border-color: #1877f2;
        }

        .btn-social.google:hover {
            color: #ea4335;
            border-color: #ea4335;
        }

        .btn-social.twitter:hover {
            color: #1da1f2;
            border-color: #1da1f2;
        }

        .create-account {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #6b7280;
        }

        .create-account a {
            color: #7c3aed;
            text-decoration: none;
            font-weight: 500;
        }

        .create-account a:hover {
            color: #5b21b6;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="card login-card"
             data-controller="login"
             data-login-login-url-value="{{ path('app.login') }}">

            <div class="app-brand">
                <div class="app-brand-logo">
                    <svg width="24" height="24" viewBox="0 0 32 22" fill="white" xmlns="http://www.w3.org/2000/svg">
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M0.00172773 0V6.85398C0.00172773 6.85398 -0.133178 9.01207 1.98092 10.8388L13.6912 21.9964L19.7809 21.9181L18.8042 9.88248L16.4951 7.17289L9.23799 0H0.00172773Z"
                            fill="currentColor" />
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M7.77295 16.3566L23.6563 0H32V6.88383C32 6.88383 31.8262 9.17836 30.6591 10.4057L19.7824 22H13.6938L7.77295 16.3566Z"
                            fill="currentColor" />
                    </svg>
                </div>
                <span class="app-brand-text">Vuexy</span>
            </div>

            <h1 class="welcome-title">Welcome to Vuexy! 👋</h1>
            <p class="welcome-subtitle">Please sign-in to your account and start the adventure</p>

            <form data-login-target="form"
                  data-action="submit->login#submitForm"
                  method="POST">

                {{ csrf_token('authenticate') ? '<input type="hidden" name="_token" value="' ~ csrf_token('authenticate') ~ '">' : '' }}

                <div class="mb-3">
                    <label for="email" class="form-label">Email or Username</label>
                    <input
                        type="text"
                        class="form-control"
                        id="email"
                        name="email"
                        data-login-target="emailInput"
                        placeholder="Enter your email or username"
                        value="{{ last_username }}"
                        required
                        autofocus
                    />
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label" for="password">Password</label>
{#                        <a href="{{ path('app_forgot_password') }}" class="forgot-password">#}
                        <a href="#" class="forgot-password">
                            Forgot Password?
                        </a>
                    </div>
                    <div class="password-toggle">
                        <input
                            type="password"
                            id="password"
                            class="form-control"
                            name="password"
                            data-login-target="passwordInput"
                            placeholder="••••••••••••"
                            required
                        />
                        <i class="fa fa-eye-slash toggle-icon"
                           data-login-target="toggleIcon"
                           data-action="click->login#togglePassword"></i>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="remember_me"
                               name="_remember_me" />
                        <label class="form-check-label" for="remember_me">
                            Remember Me
                        </label>
                    </div>
                </div>

                <div class="mb-3">
                    <button class="btn btn-primary w-100" type="submit">
                        Sign in
                    </button>
                </div>
            </form>

            <div class="create-account">
                <span>New on our platform? </span>
{#                <a href="{{ path('app_register') }}">Create an account</a>#}
                <a href="#">Create an account</a>
            </div>

            <div class="divider">
                <div class="divider-text">or</div>
            </div>

            <div class="social-buttons">
                <a href="#"
                   class="btn-social facebook"
                   data-action="click->login#loginWithFacebook">
                    <i class="fa fa-facebook-f text-primary"></i>
                </a>
                <a href="#"
                   class="btn-social google"
                   data-action="click->login#loginWithGoogle">
                    <i class="fa fa-google text-danger"></i>
                </a>
                <a href="#"
                   class="btn-social twitter"
                   data-action="click->login#loginWithTelegram">
                    <i class="fa fa-telegram text-primary"></i>
                </a>
            </div>
        </div>
    </div>
{% endblock %}
