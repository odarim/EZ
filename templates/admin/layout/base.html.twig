<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
          content="{% block meta_description %}{{ app_name|default('Modern Dashboard Application') }}{% endblock %}">
    <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">

    <title>{% block title %}{{ app_name|default('Dashboard') }}{% endblock %}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="{{ asset('images/favicon.ico') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/apple-touch-icon.png') }}">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        rel="stylesheet">

    <!-- Stylesheets -->
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    <!-- Additional Head Content -->
    {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}" data-theme="{% block theme %}light{% endblock %}">
{# <!-- Loading Overlay --> #}
{# <div class="loading-overlay" id="loadingOverlay"> #}
{#    <div class="loading-spinner"> #}
{#        <div class="spinner"></div> #}
{#        <p>Loading...</p> #}
{#    </div> #}
{# </div> #}

{# <!-- Skip to content link for accessibility --> #}
{# <a href="#main-content" class="skip-to-content visually-hidden-focusable"> #}
{#    Skip to main content #}
{# </a> #}

<!-- App Container -->
<div class="app-container" data-controller="app">
    {% if is_granted('ROLE_USER') %}
        {{ include('admin/layout/sidebar.html.twig') }}
    {% endif %}

    <!-- Main Content Area -->
    <div class="main-content" id="main-content">
        {% block header %}
            {% if is_granted('ROLE_USER') %}
                <header class="main-header border-0">
                    <div class="header-left">
                        <h1 class="page-title">Dashboard Overview</h1>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">
                                    <a href="#" class="breadcrumb-link">Home</a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="header-right">
                        <div class="header-actions">
                            <!-- Notifications -->
                            <div class="notification-wrapper">
                                <div class="notification-icon">
                    <span class="material-symbols-rounded">
                        notifications
                    </span>
                                    <span class="notification-badge">3</span>
                                </div>
                            </div>

                            <!-- User Menu -->
                            <div class="dropdown">
                                <a class="user-menu-trigger d-flex align-items-center gap-2 dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <div class="user-avatar">
                                        {{ app.user.username|slice(0, 1)|upper }}
                                    </div>
                                    <span class="user-name d-none d-md-inline">John Doe</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <span class="material-symbols-rounded me-2">account_circle</span>
                                            Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <span class="material-symbols-rounded me-2">settings</span>
                                            Settings
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <span class="material-symbols-rounded me-2">logout</span>
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </header>
            {% endif %}
        {% endblock %}

        <!-- Flash Messages -->
        {% block flash_messages %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show"
                         role="alert"
                         data-controller="alert"
                         data-alert-auto-dismiss-value="5000">
                        {{ message|raw }}
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        <!-- Page Content -->
        <main class="page-content" role="main">
            {% block body %}{% endblock %}
        </main>

        <!-- Footer -->
        {% block footer %}
            <footer class="main-footer">
                <div class="footer-content">
                    <div class="footer-left">
                        <p>&copy; {{ 'now'|date('Y') }} {{ app_name|default('Dashboard App') }}
                            . {{ 'All rights reserved.'|trans }}</p>
                    </div>
                    <div class="footer-right">
                        <a href="#" class="footer-link">{{ 'Privacy Policy'|trans }}</a>
                        <a href="#" class="footer-link">{{ 'Terms of Service'|trans }}</a>
                        <a href="#" class="footer-link">{{ 'Support'|trans }}</a>
                    </div>
                </div>
            </footer>
        {% endblock %}
    </div>
</div>

<!-- Notification Container -->
<div class="notification-container" id="notificationContainer"></div>

<!-- Modal Container -->
<div class="modal-container" id="modalContainer"></div>

<!-- Scripts -->
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {#    {% block importmap %}{{ importmap('app') }}{% endblock %} #}
{% endblock %}

<!-- Additional Scripts -->
{% block extra_javascripts %}{% endblock %}

<!-- Page-specific JavaScript -->
{% block page_scripts %}{% endblock %}

<!-- Analytics -->
{% block analytics %}
    {% if app.environment == 'prod' %}
        <!-- Add your analytics code here -->
    {% endif %}
{% endblock %}
</body>
</html>
